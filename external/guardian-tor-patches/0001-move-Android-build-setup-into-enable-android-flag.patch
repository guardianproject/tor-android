From fe8a754498a7c12117bf2f85dae731eb80165f0f Mon Sep 17 00:00:00 2001
From: Hans-Christoph Steiner <hans@eds.org>
Date: Tue, 10 Sep 2019 23:08:02 +0200
Subject: [PATCH 01/20] move Android build setup into --enable-android flag

---
 changes/ticket31882 |  7 +++++++
 configure.ac        | 16 +++++++++++++++-
 2 files changed, 22 insertions(+), 1 deletion(-)
 create mode 100644 changes/ticket31882

diff --git a/changes/ticket31882 b/changes/ticket31882
new file mode 100644
index 0000000000..bcf17ce2a8
--- /dev/null
+++ b/changes/ticket31882
@@ -0,0 +1,7 @@
+  o Minor feature (configure, build system):
+    - The standard __ANDROID__ macro is now used for platform detection.
+    - --enable-android provides the standard, minimal build configuration
+      for creating Tor binaries to run either as a shared library or a daemon.
+      It enables PIC, disables system torrc, systemd, and all doc generation.
+      This flag is not required to build for Android.
+      Closes ticket 31882.
diff --git a/configure.ac b/configure.ac
index 683db091b6..3f8b71541b 100644
--- a/configure.ac
+++ b/configure.ac
@@ -115,6 +115,20 @@ fi
 AC_SUBST(DOXYGEN_FATAL_WARNINGS)
 AC_SUBST(DOXYGEN_WARN_ON_MISSING)
 
+dnl Enable minimal, standard Android build
+AC_ARG_ENABLE(android,
+     AS_HELP_STRING(--enable-android, [setup build for Android exeutable/shared library]))
+
+if test "x$enable_android" = "xyes"; then
+  asciidoc=false
+  enable_html_manual=no
+  enable_manpage=no
+  enable_pic=yes
+  enable_system_torrc=no
+  enable_tool_name_check=no
+  have_systemd=no
+fi
+
 if test "x$enable_coverage" != "xyes" -a "x$enable_asserts_in_tests" = "xno" ; then
     AC_MSG_ERROR([Can't disable assertions outside of coverage build])
 fi
@@ -170,7 +184,7 @@ AC_ARG_ENABLE(asciidoc,
         "yes") asciidoc=true ;;
         "no")  asciidoc=false ;;
         *) AC_MSG_ERROR(bad value for --disable-asciidoc) ;;
-      esac], [asciidoc=true])
+      esac], [test "x$asciidoc" = "xtrue" && asciidoc=true])
 
 # systemd notify support
 AC_ARG_ENABLE(systemd,
-- 
2.47.3

