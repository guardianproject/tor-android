 *.h
+*.c
diff --git a/src/feature/api/tor_api.c b/src/feature/api/tor_api.c
index 88e91ebfd5..1f56e22a92 100644
--- a/src/feature/api/tor_api.c
+++ b/src/feature/api/tor_api.c
