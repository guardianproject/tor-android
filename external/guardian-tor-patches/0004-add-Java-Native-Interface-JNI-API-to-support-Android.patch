 m4/ax_jni_include_dir.m4                      | 151 ++++++++++
 src/app/main/main.c                           |   3 +
 src/feature/api/include.am                    |   8 +
 .../api/org_torproject_jni_TorService.c       | 259 ++++++++++++++++++
 .../api/org_torproject_jni_TorService.h       |  65 +++++
 6 files changed, 506 insertions(+)
